{
  "name": "whisperclick",
  "version": "2.4.4-beta",
  "description": "WhisperClick — Voice-to-text desktop app",
  "author": "Edward Shamosh",
  "main": "platforms/electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "test": "jest --forceExit",
    "test:unit": "jest tests/unit/",
    "test:integration": "jest tests/integration/",
    "test:e2e": "node tests/e2e/app.e2e.test.js",
    "test:e2e:renderer": "node tests/e2e/renderer-flow.e2e.js",
    "protect:premium": "node tools/protect-premium.js --verify",
    "build:engine": "node tools/build-engine.js",
    "pack:pro": "npm run build:engine && node tools/protect-premium.js && electron-builder --dir --config electron-builder.pro.json",
    "dist:win:pro": "npm run build:engine && node tools/protect-premium.js && electron-builder --win --config electron-builder.pro.json",
    "dist:mac:pro": "npm run build:engine && node tools/protect-premium.js && electron-builder --mac --config electron-builder.pro.json",
    "dist:linux:pro": "npm run build:engine && node tools/protect-premium.js && electron-builder --linux --config electron-builder.pro.json"
  },
  "build": {
    "appId": "com.whisperclick.app",
    "productName": "WhisperClick",
    "directories": {
      "output": "release"
    },
    "icon": "icons/icon.png",
    "files": [
      "platforms/electron/**",
      "shared/frontend/**",
      "shared/pill/**",
      "shared/media/**",
      "shared/engine/**",
      "icons/**",
      "!platforms/electron/premium/**",
      "!shared/frontend/premium/**",
      "!shared/engine/**"
    ],
    "extraResources": [
      {
        "from": "shared/engine/",
        "to": "engine/",
        "filter": [
          "**/*.py"
        ]
      }
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "WhisperClick-Setup-${version}.${ext}",
      "installerIcon": "icons/icon.ico",
      "uninstallerIcon": "icons/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "WhisperClick-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icons/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "icons/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "generateUpdatesFilesForAllChannels": true,
    "publish": {
      "provider": "generic",
      "url": "https://whisperclick.com/updates/beta/",
      "channel": "latest"
    }
  },
  "dependencies": {
    "bytenode": "^1.6.0",
    "electron-updater": "^6.6.2",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "electron": "^40.6.1",
    "electron-builder": "^26.0.12",
    "javascript-obfuscator": "^5.5.0",
    "jest": "^30.2.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.19"
  }
}
