{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperClick",
  "version": "3.0.0-alpha",
  "identifier": "com.whisperclick.app",
  "build": {
    "frontendDist": "../../shared/frontend"
  },
  "app": {
    "windows": [
      {
        "title": "WhisperClick",
        "width": 900,
        "height": 680,
        "minWidth": 480,
        "minHeight": 218,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../icons/icon.ico",
      "../../icons/icon.png"
    ]
  }
}
