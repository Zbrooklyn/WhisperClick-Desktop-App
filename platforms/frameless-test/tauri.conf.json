{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FramelessTest",
  "version": "0.1.0",
  "identifier": "com.test.frameless",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Frameless Test",
        "width": 600,
        "height": 400,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  }
}
